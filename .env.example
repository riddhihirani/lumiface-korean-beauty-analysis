# ==========================================
# LumiFace - Environment Variables Template
# Copy this file to .env and replace placeholder values.
# DO NOT commit real secret keys or production passwords to GitHub.
# ==========================================

# Backend API Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# JWT Session Authentication Secret Key (Generate a secure random string for production)
LUMIFACE_SECRET_KEY=your_secure_random_secret_key_here_min_32_chars

# SQLite Database Location (Defaults to backend/data/lumiface.db)
DATABASE_PATH=backend/data/lumiface.db

# Frontend API Base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
