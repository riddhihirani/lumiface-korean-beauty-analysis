# ==========================================
# LumiFace - Korean Beauty Diagnostics Platform
# .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secret Configuration
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------------------
# Local Database & User Storage (SECURITY CRITICAL)
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/lumiface.db

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# ------------------------------------------
# Testing & Code Coverage Caches
# ------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.nox/
.hypothesis/

# ------------------------------------------
# Next.js & Frontend Build Outputs
# ------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ------------------------------------------
# Package Manager Logs & Locks
# ------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# Temporary & Generated Artifacts
# ------------------------------------------
*.pdf
scratch/
.system_generated/

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
